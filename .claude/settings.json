{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git pull*)",
      "Bash(git push*)",
      "Bash(git fetch*)",
      "Bash(git checkout*)",
      "Bash(git rebase*)",
      "Bash(python refresh.py*)",
      "Bash(py refresh.py*)",
      "Bash(python -m pip install*)"
    ]
  }
}
